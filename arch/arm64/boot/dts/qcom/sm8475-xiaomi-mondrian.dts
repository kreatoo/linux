				clock-names = "iface", "ref";
				status = "okay";
				vdds-supply = <0x9b>;
				phandle = <0xd5>;
			};

			dsi@ae96000 {
				compatible = "qcom,sm8450-dsi-ctrl", "qcom,mdss-dsi-ctrl";
