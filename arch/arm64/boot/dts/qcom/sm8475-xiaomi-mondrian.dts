				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;

						endpoint {
							remote-endpoint = <0xf8>;
							phandle = <0x107>;
						};
					};

					port@1 {
						reg = <0x01>;

						endpoint {
							remote-endpoint = <0xf9>;
							phandle = <0xa7>;
						};
					};
				};
			};
		};

		interconnect@320c0000 {
			compatible = "qcom,sm8450-nsp-noc";
			reg = <0x00 0x320c0000 0x00 0x10000>;
			#interconnect-cells = <0x02>;
			qcom,bcm-voters = <0x20>;
		};

		interconnect@3c40000 {
			compatible = "qcom,sm8450-lpass-ag-noc";
			reg = <0x00 0x3c40000 0x00 0x17200>;
			#interconnect-cells = <0x02>;
			qcom,bcm-voters = <0x20>;
		};

		phy@1d80000 {
			compatible = "qcom,sm8475-qmp-ufs-phy";
			reg = <0x00 0x1d80000 0x00 0x2000>;
			clocks = <0x2b 0x00 0x02 0x9d 0x02 0x95>;
			clock-names = "ref", "ref_aux", "qref";
			resets = <0xfa 0x00>;
			reset-names = "ufsphy";
			#clock-cells = <0x01>;
			#phy-cells = <0x00>;
			status = "okay";
			vdda-phy-supply = <0x9b>;
			vdda-pll-supply = <0x9c>;
			phandle = <0x2f>;
		};

		pmic-glink {
			status = "disabled";
		};
	};

