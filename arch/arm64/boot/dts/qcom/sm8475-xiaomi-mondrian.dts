					output-high;
				};

				data-pins {
					pins = "gpio9";
					function = "dmic2_data";
					drive-strength = <0x08>;
				};
			};

			wsa-swr-active-state {
				phandle = <0xb4>;

				clk-pins {
					pins = "gpio10";
					function = "wsa_swr_clk";
					drive-strength = <0x02>;
					slew-rate = <0x01>;
