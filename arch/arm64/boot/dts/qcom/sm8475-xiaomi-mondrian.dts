/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Xiaomi POCO F5 Pro / Redmi K60";
	compatible = "xiaomi,mondrian", "qcom,sm8475";
	chassis-type = "handset";

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		framebuffer@b8000000 {
			compatible = "simple-framebuffer";
			reg = <0x00 0xb8000000 0x00 0x2b00000>;
			width = <0x5a0>;
			height = <0xc80>;
			stride = <0x1680>;
			format = "a8r8g8b8";
			clocks = <0x02 0x1c>;
		};
	};

	clocks {

		xo-board {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x493e000>;
			phandle = <0xe9>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7d00>;
			phandle = <0x2c>;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo780";
			reg = <0x00 0x00>;
			enable-method = "psci";
			next-level-cache = <0x03>;
			power-domains = <0x04>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x05 0x00>;
			#cooling-cells = <0x02>;
			clocks = <0x05 0x00>;
			phandle = <0x15>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x03>;

				l3-cache {
					compatible = "cache";
					cache-level = <0x03>;
					cache-unified;
					phandle = <0x06>;
				};
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo780";
			reg = <0x00 0x100>;
			enable-method = "psci";
			next-level-cache = <0x07>;
			power-domains = <0x08>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x05 0x00>;
			#cooling-cells = <0x02>;
			clocks = <0x05 0x00>;
			phandle = <0x16>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x07>;
			};
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "qcom,kryo780";
			reg = <0x00 0x200>;
			enable-method = "psci";
			next-level-cache = <0x09>;
			power-domains = <0x0a>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x05 0x00>;
			#cooling-cells = <0x02>;
			clocks = <0x05 0x00>;
			phandle = <0x17>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x09>;
			};
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "qcom,kryo780";
			reg = <0x00 0x300>;
			enable-method = "psci";
			next-level-cache = <0x0b>;
			power-domains = <0x0c>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x05 0x00>;
			#cooling-cells = <0x02>;
			clocks = <0x05 0x00>;
			phandle = <0x18>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x0b>;
			};
		};

		cpu@400 {
			device_type = "cpu";
			compatible = "qcom,kryo780";
			reg = <0x00 0x400>;
			enable-method = "psci";
			next-level-cache = <0x0d>;
			power-domains = <0x0e>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x05 0x01>;
			#cooling-cells = <0x02>;
			clocks = <0x05 0x01>;
			phandle = <0x19>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x0d>;
			};
		};

		cpu@500 {
			device_type = "cpu";
			compatible = "qcom,kryo780";
			reg = <0x00 0x500>;
			enable-method = "psci";
			next-level-cache = <0x0f>;
			power-domains = <0x10>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x05 0x01>;
			#cooling-cells = <0x02>;
			clocks = <0x05 0x01>;
			phandle = <0x1a>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x0f>;
			};
		};

		cpu@600 {
			device_type = "cpu";
			compatible = "qcom,kryo780";
			reg = <0x00 0x600>;
			enable-method = "psci";
			next-level-cache = <0x11>;
			power-domains = <0x12>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x05 0x01>;
			#cooling-cells = <0x02>;
			clocks = <0x05 0x01>;
			phandle = <0x1b>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x11>;
			};
		};

		cpu@700 {
			device_type = "cpu";
			compatible = "qcom,kryo780";
			reg = <0x00 0x700>;
			enable-method = "psci";
			next-level-cache = <0x13>;
			power-domains = <0x14>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x05 0x02>;
			#cooling-cells = <0x02>;
			clocks = <0x05 0x02>;
			phandle = <0x1c>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x13>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x15>;
				};

				core1 {
					cpu = <0x16>;
				};

				core2 {
					cpu = <0x17>;
				};

				core3 {
					cpu = <0x18>;
				};

				core4 {
					cpu = <0x19>;
				};

				core5 {
					cpu = <0x1a>;
				};

				core6 {
					cpu = <0x1b>;
				};

				core7 {
					cpu = <0x1c>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0-0 {
				compatible = "arm,idle-state";
				idle-state-name = "silver-rail-power-collapse";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x320>;
				exit-latency-us = <0x2ee>;
				min-residency-us = <0xffa>;
				local-timer-stop;
				phandle = <0x22>;
			};

			cpu-sleep-1-0 {
				compatible = "arm,idle-state";
				idle-state-name = "gold-rail-power-collapse";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x258>;
				exit-latency-us = <0x60e>;
				min-residency-us = <0x12b7>;
				local-timer-stop;
				phandle = <0x23>;
			};
		};

		domain-idle-states {

			cluster-sleep-0 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x41000044>;
				entry-latency-us = <0x41a>;
				exit-latency-us = <0x9c4>;
				min-residency-us = <0x14bd>;
				phandle = <0x24>;
			};

			cluster-sleep-1 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x4100c344>;
				entry-latency-us = <0xa8c>;
				exit-latency-us = <0xdac>;
				min-residency-us = <0x3687>;
				phandle = <0x25>;
			};
		};
	};

	firmware {

		scm {
			compatible = "qcom,scm-sm8450", "qcom,scm";
			qcom,dload-mode = <0x1d 0x13000>;
			interconnects = <0x1e 0x04 0x00 0x1f 0x01 0x00>;
			#reset-cells = <0x01>;
		};
	};

	interconnect-0 {
		compatible = "qcom,sm8450-clk-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x20>;
		phandle = <0x33>;
	};

	interconnect-1 {
		compatible = "qcom,sm8450-mc-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x20>;
		phandle = <0x1f>;
	};

	memory@a0000000 {
		device_type = "memory";
		reg = <0x00 0xa0000000 0x00 0x00>;
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x01 0x07 0x04>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";

		power-domain-cpu0 {
			#power-domain-cells = <0x00>;
			power-domains = <0x21>;
			domain-idle-states = <0x22>;
			phandle = <0x04>;
		};

		power-domain-cpu1 {
			#power-domain-cells = <0x00>;
			power-domains = <0x21>;
			domain-idle-states = <0x22>;
			phandle = <0x08>;
		};

		power-domain-cpu2 {
			#power-domain-cells = <0x00>;
			power-domains = <0x21>;
			domain-idle-states = <0x22>;
			phandle = <0x0a>;
		};

		power-domain-cpu3 {
			#power-domain-cells = <0x00>;
			power-domains = <0x21>;
			domain-idle-states = <0x22>;
			phandle = <0x0c>;
		};

		power-domain-cpu4 {
			#power-domain-cells = <0x00>;
			power-domains = <0x21>;
			domain-idle-states = <0x23>;
			phandle = <0x0e>;
		};

		power-domain-cpu5 {
			#power-domain-cells = <0x00>;
			power-domains = <0x21>;
			domain-idle-states = <0x23>;
			phandle = <0x10>;
		};

		power-domain-cpu6 {
			#power-domain-cells = <0x00>;
			power-domains = <0x21>;
			domain-idle-states = <0x23>;
			phandle = <0x12>;
		};

		power-domain-cpu7 {
			#power-domain-cells = <0x00>;
			power-domains = <0x21>;
			domain-idle-states = <0x23>;
			phandle = <0x14>;
		};

		power-domain-cpu-cluster0 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x24 0x25>;
			phandle = <0x21>;
		};
	};

	opp-table-qup {
		compatible = "operating-points-v2";
		phandle = <0x5a>;

		opp-50000000 {
			opp-hz = <0x00 0x2faf080>;
			required-opps = <0x26>;
		};

		opp-75000000 {
			opp-hz = <0x00 0x47868c0>;
			required-opps = <0x27>;
		};

		opp-100000000 {
			opp-hz = <0x00 0x5f5e100>;
			required-opps = <0x28>;
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		memory@80000000 {
			reg = <0x00 0x80000000 0x00 0x600000>;
			no-map;
		};

		memory@80600000 {
			reg = <0x00 0x80600000 0x00 0x40000>;
			no-map;
		};

		memory@80640000 {
			reg = <0x00 0x80640000 0x00 0x180000>;
			no-map;
		};

		memory@807c0000 {
			reg = <0x00 0x807c0000 0x00 0x40000>;
			no-map;
		};

		memory@80800000 {
			reg = <0x00 0x80800000 0x00 0x60000>;
			no-map;
		};

		memory@80860000 {
			compatible = "qcom,cmd-db";
			reg = <0x00 0x80860000 0x00 0x20000>;
			no-map;
		};

		memory@80880000 {
			reg = <0x00 0x80880000 0x00 0x20000>;
			no-map;
		};

		memory@808a0000 {
			reg = <0x00 0x808a0000 0x00 0x40000>;
			no-map;
		};

		memory@808e0000 {
			reg = <0x00 0x808e0000 0x00 0x4000>;
			no-map;
		};

		memory@808e4000 {
			reg = <0x00 0x808e4000 0x00 0x10000>;
			no-map;
		};

		memory@80900000 {
			compatible = "qcom,smem";
			reg = <0x00 0x80900000 0x00 0x200000>;
			hwlocks = <0x29 0x03>;
			no-map;
		};

		memory@80b00000 {
			reg = <0x00 0x80b00000 0x00 0x100000>;
			no-map;
		};

		memory@80c00000 {
			reg = <0x00 0x80c00000 0x00 0x4600000>;
			no-map;
		};

		memory@85700000 {
			reg = <0x00 0x85700000 0x00 0x2800000>;
			no-map;
			phandle = <0xb8>;
		};

		memory@88000000 {
			reg = <0x00 0x88000000 0x00 0x1900000>;
			no-map;
			phandle = <0xab>;
		};

		memory@89900000 {
			reg = <0x00 0x89900000 0x00 0x2000000>;
			no-map;
			phandle = <0xbb>;
		};

		memory@8b900000 {
			reg = <0x00 0x8b900000 0x00 0x10000>;
			no-map;
		};

		memory@8b910000 {
			reg = <0x00 0x8b910000 0x00 0xa000>;
			no-map;
		};

		memory@8b91a000 {
			reg = <0x00 0x8b91a000 0x00 0x2000>;
			no-map;
			phandle = <0xa2>;
		};

		memory@8ba00000 {
			reg = <0x00 0x8ba00000 0x00 0x180000>;
			no-map;
		};

		memory@8bb80000 {
			reg = <0x00 0x8bb80000 0x00 0x60000>;
			no-map;
		};

		memory@8bbe0000 {
			reg = <0x00 0x8bbe0000 0x00 0x20000>;
			no-map;
		};

		memory@8bc00000 {
			reg = <0x00 0x8bc00000 0x00 0x13200000>;
			no-map;
			phandle = <0xbe>;
		};

		memory@9ee00000 {
			reg = <0x00 0x9ee00000 0x00 0x700000>;
			no-map;
		};

		memory@9f500000 {
			reg = <0x00 0x9f500000 0x00 0x800000>;
			no-map;
		};

		memory@9fd00000 {
			reg = <0x00 0x9fd00000 0x00 0x700000>;
			no-map;
		};

		memory@a6e00000 {
			reg = <0x00 0xa6e00000 0x00 0x40000>;
			no-map;
		};

		memory@a6f00000 {
			reg = <0x00 0xa6f00000 0x00 0x100000>;
			no-map;
		};

		memory@bb000000 {
			reg = <0x00 0xbb000000 0x00 0x5000000>;
			no-map;
		};

		memory@c0000000 {
			reg = <0x00 0xc0000000 0x00 0x20000000>;
			no-map;
		};

		memory@e0000000 {
			reg = <0x00 0xe0000000 0x00 0x600000>;
			no-map;
		};

		memory@e0600000 {
			reg = <0x00 0xe0600000 0x00 0x400000>;
			no-map;
		};

		memory@e0a00000 {
			reg = <0x00 0xe0a00000 0x00 0x100000>;
			no-map;
		};

		memory@e0b00000 {
			reg = <0x00 0xe0b00000 0x00 0x4af3000>;
			no-map;
		};

		memory@e55f3000 {
			reg = <0x00 0xe55f3000 0x00 0x9000>;
			no-map;
		};

		memory@e55fc000 {
			reg = <0x00 0xe55fc000 0x00 0x4000>;
			no-map;
		};

		memory@e5600000 {
			reg = <0x00 0xe5600000 0x00 0x100000>;
			no-map;
		};

		memory@e8800000 {
			reg = <0x00 0xe8800000 0x00 0x100000>;
			no-map;
		};

		memory@e8900000 {
			reg = <0x00 0xe8900000 0x00 0x1200000>;
			no-map;
		};

		memory@e9b00000 {
			reg = <0x00 0xe9b00000 0x00 0x500000>;
			no-map;
		};

		memory@ea000000 {
			reg = <0x00 0xea000000 0x00 0x3900000>;
			no-map;
		};

		memory@ed900000 {
			reg = <0x00 0xed900000 0x00 0x3b00000>;
			no-map;
		};

		ramoops@85200000 {
			compatible = "ramoops";
			reg = <0x00 0x85200000 0x00 0x400000>;
			record-size = <0x200000>;
			pmsg-size = <0x200000>;
			console-size = <0x200000>;
			no-map;
		};

		splash_region@b8000000 {
			reg = <0x00 0xb8000000 0x00 0x2b00000>;
			no-map;
		};

		memory@fc700000 {
			compatible = "qcom,rmtfs-mem";
			reg = <0x00 0xf3300000 0x00 0x280000>;
			no-map;
			qcom,client-id = <0x01>;
			qcom,vmid = <0x0f>;
		};
	};

	smp2p-adsp {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1bb 0x1ad>;
		interrupts-extended = <0x2a 0x03 0x02 0x01>;
		mboxes = <0x2a 0x03 0x02>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x02>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0xb9>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0xb7>;
		};
	};

	smp2p-cdsp {
		compatible = "qcom,smp2p";
		qcom,smem = <0x5e 0x1b0>;
		interrupts-extended = <0x2a 0x06 0x02 0x01>;
		mboxes = <0x2a 0x06 0x02>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x05>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0xbc>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0xba>;
		};
	};

	smp2p-modem {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1b3 0x1ac>;
		interrupts-extended = <0x2a 0x02 0x02 0x01>;
		mboxes = <0x2a 0x02 0x02>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x01>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0xbf>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0xbd>;
		};

		ipa-ap-to-modem {
			qcom,entry-name = "ipa";
			#qcom,smem-state-cells = <0x01>;
		};

		ipa-modem-to-ap {
			qcom,entry-name = "ipa";
			interrupt-controller;
			#interrupt-cells = <0x02>;
		};
	};

	smp2p-slpi {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1e1 0x1ae>;
		interrupts-extended = <0x2a 0x04 0x02 0x01>;
		mboxes = <0x2a 0x04 0x02>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x03>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0xac>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0xaa>;
		};
	};

	soc@0 {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges = <0x00 0x00 0x00 0x00 0x10 0x00>;
		dma-ranges = <0x00 0x00 0x00 0x00 0x10 0x00>;
		compatible = "simple-bus";

		clock-controller@100000 {
			compatible = "qcom,sm8475-gcc";
			reg = <0x00 0x100000 0x00 0x1f4200>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			#power-domain-cells = <0x01>;
			clocks = <0x2b 0x00 0x2c 0x2d 0x2e 0x00 0x2e 0x01 0x2f 0x00 0x2f 0x01 0x2f 0x02 0x30 0x00>;
