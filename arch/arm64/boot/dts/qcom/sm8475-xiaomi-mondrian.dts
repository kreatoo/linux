					phandle = <0xd2>;

					opp-160000000 {
						opp-hz = <0x00 0x9896800>;
						required-opps = <0x27>;
					};

					opp-270000000 {
						opp-hz = <0x00 0x1017df80>;
						required-opps = <0x28>;
					};

					opp-540000000 {
						opp-hz = <0x00 0x202fbf00>;
						required-opps = <0xd1>;
					};

					opp-810000000 {
						opp-hz = <0x00 0x30479e80>;
						required-opps = <0x98>;
					};
				};
			};

			dsi@ae94000 {
				compatible = "qcom,sm8450-dsi-ctrl", "qcom,mdss-dsi-ctrl";
				reg = <0x00 0xae94000 0x00 0x400>;
				reg-names = "dsi_ctrl";
				interrupt-parent = <0xcc>;
				interrupts = <0x04>;
				clocks = <0xca 0x03 0xca 0x06 0xca 0x41 0xca 0x37 0xca 0x01 0x02 0x1c>;
				clock-names = "byte", "byte_intf", "pixel", "core", "iface", "bus";
				assigned-clocks = <0xca 0x04 0xca 0x42>;
				assigned-clock-parents = <0xd5 0x00 0xd5 0x01>;
				operating-points-v2 = <0xd6>;
				power-domains = <0x59 0x06>;
				phys = <0xd5>;
				phy-names = "dsi";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "okay";
				vdda-supply = <0xd7>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;

						endpoint {
							remote-endpoint = <0xd8>;
							phandle = <0xcd>;
						};
					};

					port@1 {
						reg = <0x01>;

						endpoint {
							remote-endpoint = <0xd9>;
							data-lanes = <0x00 0x01 0x02 0x03>;
							phandle = <0xdf>;
						};
					};
				};

				opp-table {
					compatible = "operating-points-v2";
					phandle = <0xd6>;

					opp-187500000 {
						opp-hz = <0x00 0xb2d05e0>;
						required-opps = <0x27>;
					};

					opp-300000000 {
						opp-hz = <0x00 0x11e1a300>;
						required-opps = <0x28>;
					};

					opp-358000000 {
						opp-hz = <0x00 0x1556a580>;
						required-opps = <0xd1>;
					};
				};

				panel@0 {
					compatible = "visionox,nt37705";
					reg = <0x00>;
					reset-gpios = <0x67 0x00 0x01>;
					vdd-supply = <0xda>;
					vddio-supply = <0x69>;
					pinctrl-0 = <0xdb 0xdc>;
					pinctrl-1 = <0xdd 0xde>;
					pinctrl-names = "default", "sleep";

					port {

						endpoint {
							remote-endpoint = <0xdf>;
							phandle = <0xd9>;
						};
					};
				};
			};

			phy@ae94400 {
