				clock-names = "byte", "byte_intf", "pixel", "core", "iface", "bus";
				assigned-clocks = <0xca 0x08 0xca 0x44>;
				assigned-clock-parents = <0xe0 0x00 0xe0 0x01>;
				operating-points-v2 = <0xd6>;
				power-domains = <0x59 0x06>;
				phys = <0xe0>;
				phy-names = "dsi";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
