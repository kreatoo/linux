	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0xff08 0x01 0x0e 0xff08 0x01 0x0b 0xff08 0x01 0x0a 0xff08>;
		clock-frequency = <0x124f800>;
	};

	reboot-mode {
		compatible = "nvmem-reboot-mode";
		nvmem-cells = <0x105>;
		nvmem-cell-names = "reboot-mode";
		mode-recovery = <0x01>;
		mode-bootloader = <0x02>;
	};

	aliases {
		hsuart0 = "/soc@0/geniqup@8c0000/serial@894000";
		serial0 = "/soc@0/geniqup@9c0000/serial@99c000";
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <0x106>;
		pinctrl-names = "default";

		key-volume-up {
			label = "Volume Up";
			linux,code = <0x73>;
			gpios = <0xe2 0x06 0x01>;
			debounce-interval = <0x0f>;
			linux,can-disable;
			wakeup-source;
		};
	};

	pmic-glink {
		compatible = "qcom,sm8475-pmic-glink", "qcom,sm8450-pmic-glink", "qcom,pmic-glink";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		orientation-gpios = <0x67 0x5b 0x00>;

		connector@0 {
			compatible = "usb-c-connector";
			reg = <0x00>;
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0x107>;
						phandle = <0xf8>;
					};
				};

				port@2 {
					reg = <0x02>;

					endpoint {
						remote-endpoint = <0x108>;
						phandle = <0x6e>;
					};
				};
			};
		};
	};

	vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <0x387520>;
		regulator-max-microvolt = <0x387520>;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0xeb>;
	};

	wcn6855-pmu {
		compatible = "qcom,wcn6855-pmu";
		pinctrl-0 = <0x109>;
		pinctrl-names = "default";
		wlan-enable-gpios = <0x67 0x50 0x00>;
		bt-enable-gpios = <0x67 0x51 0x00>;
		vddio-supply = <0x6f>;
		vddaon-supply = <0xef>;
		vddpmu-supply = <0xec>;
		vddrfa0p95-supply = <0xec>;
		vddrfa1p3-supply = <0xed>;
		vddrfa1p9-supply = <0xee>;
		vddpcie1p3-supply = <0xed>;
		vddpcie1p9-supply = <0xee>;

		regulators {

			ldo0 {
				regulator-name = "vreg_pmu_rfa_cmn_0p8";
				phandle = <0x48>;
			};

			ldo1 {
				regulator-name = "vreg_pmu_aon_0p8";
				phandle = <0x49>;
			};

			ldo2 {
				regulator-name = "vreg_pmu_wlcx_0p8";
				phandle = <0x4a>;
			};

			ldo3 {
				regulator-name = "vreg_pmu_wlmx_0p8";
				phandle = <0x4b>;
			};

			ldo4 {
				regulator-name = "vreg_pmu_btcmx_0p8";
				phandle = <0x4c>;
			};

			ldo5 {
				regulator-name = "vreg_pmu_pcie_1p8";
				phandle = <0x99>;
			};

			ldo6 {
				regulator-name = "vreg_pmu_pcie_0p9";
				phandle = <0x9a>;
			};

			ldo7 {
				regulator-name = "vreg_pmu_rfa_0p8";
				phandle = <0x4d>;
			};

			ldo8 {
				regulator-name = "vreg_pmu_rfa_1p2";
				phandle = <0x4e>;
			};

			ldo9 {
				regulator-name = "vreg_pmu_rfa_1p7";
				phandle = <0x4f>;
			};
		};
	};
};
